<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BotAgent.Package.TokenQuota</AssemblyName>
    <Version>1.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schema/preset.token-quota.14-15.up.sql" LogicalName="BotAgent.Schema.preset.token-quota.14-15.up.sql" />
    <EmbeddedResource Include="Schema/preset.token-quota.14-15.down.sql" LogicalName="BotAgent.Schema.preset.token-quota.14-15.down.sql" />
  </ItemGroup>
  <ItemGroup Condition="'$(PluginSdkPath)' == ''">
    <ProjectReference Include="../../../sdk/BotAgent.PluginApi/BotAgent.PluginApi.csproj" Private="false" />
    <ProjectReference Include="../../../sdk/contracts/plugin/BotAgent.Plugin.Contracts.csproj" Private="false" />
    <ProjectReference Include="../../../sdk/contracts/quota/BotAgent.Quota.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(PluginSdkPath)' != ''">
    <Reference Include="BotAgent.Core" HintPath="$(PluginSdkPath)/BotAgent.Core.dll" Private="false" />
    <Reference Include="BotAgent.Plugin.Contracts" HintPath="$(PluginSdkPath)/BotAgent.Plugin.Contracts.dll" Private="false" />
    <Reference Include="BotAgent.Quota.Contracts" HintPath="$(PluginSdkPath)/BotAgent.Quota.Contracts.dll" Private="false" />
  </ItemGroup>
</Project>
