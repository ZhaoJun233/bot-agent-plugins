  "Permissions": [
    "network.public-read",
    "model.grounded-text",
    "tools.execute"
  ],
  "Dependencies": [],
  "Settings": [
    {
      "Key": "enableLinkPreview",
      "Label": "链接预览",
      "Type": "boolean",
      "DefaultValue": "true",
      "Required": false
    },
    {
      "Key": "enableWebSearch",
      "Label": "联网搜索",
      "Type": "boolean",
      "DefaultValue": "true",
      "Required": false
    },
    {
      "Key": "webSearchUseModelSearch",
      "Label": "优先使用模型搜索",
      "Type": "boolean",
      "DefaultValue": "true",
      "Required": false
    },
    {
      "Key": "webSearchSources",
      "Label": "搜索源模板",
      "Type": "string",
      "DefaultValue": "wiki|https://zh.wikipedia.org/w/api.php?action=query&list=search&srsearch={q}&format=json&srlimit=5&utf8=1",
      "Required": false
    },
    {
      "Key": "webSearchMaxResults",
      "Label": "搜索结果数量",
      "Type": "number",
      "DefaultValue": "5",
      "Required": false,
      "NumberConstraints": {
        "Minimum": 1,
        "Maximum": 10,
        "Integer": true
      }
    },
    {
      "Key": "webSearchCooldownSeconds",
      "Label": "搜索冷却（秒）",
      "Type": "number",
      "DefaultValue": "30",
      "Required": false,
      "NumberConstraints": {
        "Minimum": 0,
        "Maximum": 86400,
        "Integer": true
      }
    },
    {
      "Key": "webSearchTimeoutSeconds",
      "Label": "搜索超时（秒）",
      "Type": "number",
      "DefaultValue": "20",
      "Required": false,
      "NumberConstraints": {
        "Minimum": 5,
        "Maximum": 60,
        "Integer": true
      }
    },
    {
      "Key": "linkPreviewTimeoutSeconds",
      "Label": "链接预览超时（秒）",
      "Type": "number",
      "DefaultValue": "5",
      "Required": false,
      "NumberConstraints": {
        "Minimum": 2,
        "Maximum": 30,
        "Integer": true
      }
    },
    {
      "Key": "linkPreviewMax",
      "Label": "链接预览数量",
      "Type": "number",
      "DefaultValue": "3",
      "Required": false,
      "NumberConstraints": {
        "Minimum": 0,
        "Maximum": 5,
        "Integer": true
      }
    }
  ],
  "ToolApiVersion": 1,
  "SharedContracts": [
    {
      "Name": "BotAgent.Research.Contracts",
      "Version": "1.0.0.0",
