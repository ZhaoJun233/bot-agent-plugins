{
  "schemaVersion": 1,
  "manifest": {
    "Id": "preset.feature.knowledge",
    "Version": "1.1.0",
    "EntryAssembly": "BotAgent.Package.Knowledge.dll",
    "EntryType": "BotAgent.Packages.Knowledge.KnowledgePackagePlugin",
    "Sha256": "3e475559b5320dbdf361e73944dc2004fe6f0ea7303fe770562f9b4f4bdd5e70",
    "DownloadUrl": "https://github.com/ZhaoJun233/bot-agent-plugins/releases/download/preset.feature.knowledge-1.1.0/preset.feature.knowledge-1.1.0.zip",
    "ApiVersion": 1,
    "TargetFramework": "net10.0",
    "MinimumHostVersion": "1.4.0",
    "Permissions": [
      "tools.execute"
    ],
    "Dependencies": [],
    "Settings": [
      {
        "Key": "maxDocsPerScope",
        "Label": "单会话最大文档数（上限 256）",
        "Type": "number",
        "DefaultValue": "256",
        "Required": false,
        "NumberConstraints": {
          "Minimum": 16,
          "Maximum": 256,
          "Integer": true
        }
      },
      {
        "Key": "maxChunkChars",
        "Label": "分块最大字符数",
        "Type": "number",
        "DefaultValue": "800",
        "Required": false,
        "NumberConstraints": {
          "Minimum": 200,
          "Maximum": 1600,
          "Integer": true
        }
      },
      {
        "Key": "defaultTopK",
        "Label": "默认检索返回片段数",
        "Type": "number",
        "DefaultValue": "4",
        "Required": false,
        "NumberConstraints": {
          "Minimum": 1,
          "Maximum": 10,
          "Integer": true
        }
      }
    ],
    "ToolApiVersion": 1,
    "SharedContracts": [
      {
        "Name": "BotAgent.Knowledge.Contracts",
        "Version": "1.0.0.0",
        "Sha256": "8c2747ef78a2b5fcf8bfe31b58bf4364935cef7a9aa2ff08dfffbafee0a425c9",
        "Owner": "preset.feature.knowledge"
      }
    ]
  },
  "metadata": {
    "Name": "知识库沉淀",
    "Summary": "按会话作用域存储、分块检索与管理轻量知识文档。",
    "Description": "提供基于宿主受控存储的知识库导入、分段切片与关键词 Top-K 检索能力，支持在对话中引用已有资料。",
    "Category": "记忆与隐私",
    "Author": "Bot Agent Contributors",
    "Repository": "https://github.com/ZhaoJun233/bot-agent-plugins",
    "License": "MIT",
    "Usage": "在「插件中心」安装并启用后，可通过工具写入并检索当前会话作用域内的知识文档。",
    "RiskNotice": "知识库文档仅存储在当前宿主实例目录中，请在导入前确认成员信息与文档合规边界。",
    "Configuration": "可在插件设置中调整单会话最大文档数、分块最大字符数及默认检索返回片段数。",
    "Compatibility": "Plugin API v1，目标框架 net10.0，最低宿主版本 1.4.0；声明共享契约需冷启重启生效，支持从历史内置 1.0.0 平滑升级。",
    "Changelog": "1.1.0：首次作为官方独立插件包发布至插件市场仓库。",
    "Maintenance": "由 Bot Agent 官方团队随插件市场仓库维护",
    "PermissionNotes": "声明 tools.execute；数据读写完全经宿主作用域端口隔离，不直接暴露底层数据库连接。",
    "Tags": [
      "知识库",
      "记忆与隐私",
      "官方包"
    ],
    "Runtime": "dotnet",
    "SourceKind": "official"
  }
}
