{
  "schemaVersion": 1,
  "manifest": {
    "Id": "preset.feature.documents",
    "Version": "1.1.0",
    "EntryAssembly": "BotAgent.Package.Documents.dll",
    "EntryType": "BotAgent.Packages.Documents.DocumentsPackagePlugin",
    "Sha256": "45f3415be7abf3391ea377313d91affc2a5dab248539aa501926b5e716138fff",
    "DownloadUrl": "https://github.com/ZhaoJun233/bot-agent-plugins/releases/download/preset.feature.documents-1.1.0/preset.feature.documents-1.1.0.zip",
    "ApiVersion": 1,
    "TargetFramework": "net10.0",
    "MinimumHostVersion": "1.4.0",
    "Permissions": [
      "network.public-read",
      "tools.execute"
    ],
    "Dependencies": [],
    "Settings": [
      {
        "Key": "autoExtractInbound",
        "Label": "入站附件自动提取首屏摘要",
        "Type": "boolean",
        "DefaultValue": "true",
        "Required": false
      },
      {
        "Key": "maxFileBytes",
        "Label": "单文件最大字节数（上限 10 MiB）",
        "Type": "number",
        "DefaultValue": "10485760",
        "Required": false,
        "NumberConstraints": {
          "Minimum": 65536,
          "Maximum": 10485760,
          "Integer": true
        }
      },
      {
        "Key": "maxInlineChars",
        "Label": "单次提取最大字符数",
        "Type": "number",
        "DefaultValue": "6000",
        "Required": false,
        "NumberConstraints": {
          "Minimum": 500,
          "Maximum": 12000,
          "Integer": true
        }
      }
    ],
    "ToolApiVersion": 1,
    "SharedContracts": [
      {
        "Name": "BotAgent.Documents.Contracts",
        "Version": "1.0.0.0",
        "Sha256": "dee590eef9dca53f3c0b90f0956a9eeef7ab889b99646804d73b58112a7455ba",
        "Owner": "preset.feature.documents"
      }
    ]
  },
  "metadata": {
    "Name": "文档与附件提取",
    "Summary": "从入站 PDF、文本与办公文档提取纯文本内容。",
    "Description": "解析群聊或私聊上传的文档附件，支持基于文件魔数与大小限制的安全提取，并为模型提供受边界约束的文档阅读工具。",
    "Category": "检索与工具",
    "Author": "Bot Agent Contributors",
    "Repository": "https://github.com/ZhaoJun233/bot-agent-plugins",
    "License": "MIT",
    "Usage": "在「插件中心」安装并启用后，可在会话设置中开启文档提取并调用文档阅读工具。",
    "RiskNotice": "解析外部文档内容前会校验大小与魔数，但文档文本仍属于不可信外部输入。",
    "Configuration": "可在插件设置中配置入站自动摘取首屏、单文件最大字节数（上限 10 MiB）及单次提取最大字符数。",
    "Compatibility": "Plugin API v1，目标框架 net10.0，最低宿主版本 1.4.0；声明共享契约需冷启重启生效，支持从历史内置 1.0.0 平滑升级。",
    "Changelog": "1.1.0：首次作为官方独立插件包发布至插件市场仓库。",
    "Maintenance": "由 Bot Agent 官方团队随插件市场仓库维护",
    "PermissionNotes": "声明 network.public-read（按安全 URL 获取文档）与 tools.execute；受宿主私有网段屏蔽与大小上限约束。",
    "Tags": [
      "文档解析",
      "检索与工具",
      "官方包"
    ],
    "Runtime": "dotnet",
    "SourceKind": "official"
  }
}
