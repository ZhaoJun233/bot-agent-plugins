{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BotAgent Python-only multi-version repository API 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SchemaVersion",
    "Plugins"
  ],
  "properties": {
    "SchemaVersion": {
      "const": 2
    },
    "Plugins": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "Id",
          "Versions"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "Versions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "$ref": "https://raw.githubusercontent.com/ZhaoJun233/bot-agent-plugins/main/schemas/python-manifest.schema.json"
            }
          }
        }
      }
    }
  }
}
