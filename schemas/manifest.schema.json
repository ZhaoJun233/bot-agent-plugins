{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ZhaoJun233/bot-agent-plugins/main/schemas/manifest.schema.json",
  "title": "BotAgent plugin manifest API 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Id",
    "Version",
    "EntryAssembly",
    "EntryType",
    "Sha256",
    "DownloadUrl",
    "ApiVersion"
  ],
  "properties": {
    "Id": {
      "$ref": "#/$defs/id"
    },
    "Version": {
      "$ref": "#/$defs/version"
    },
    "EntryAssembly": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\\.dll$"
    },
    "EntryType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.+`]*$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "DownloadUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.zip$"
    },
    "ApiVersion": {
      "const": 1
    },
    "TargetFramework": {
      "enum": [
        "net8.0",
        "net10.0"
      ],
      "default": "net8.0"
    },
    "MinimumHostVersion": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+){0,2}$"
        }
      ]
    },
    "Permissions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{0,79}$"
      }
    },
    "Dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "Settings": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/setting"
      }
    },
    "ToolApiVersion": {
      "anyOf": [
        {
          "const": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "SharedContracts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/sharedContract"
      }
    },
    "Data": {
      "$ref": "#/$defs/data"
    },
    "Control": {
      "type": "boolean"
    },
    "Configuration": {
      "$ref": "#/$defs/configuration"
    },
    "Ui": {
      "$ref": "#/$defs/ui"
    },
    "Adoption": {
      "enum": [
        "cold",
        "online"
      ]
    },
    "ExclusiveResources": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{0,79}$"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?!system\\.)(?:preset\\.feature\\.[a-z0-9][a-z0-9-]{0,63}|(?!preset\\.)(?!.*\\.\\.)(?!.*\\.$)[a-z][a-z0-9.-]{0,79})$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$",
      "allOf": [
        {
          "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$"
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Id",
        "Version"
      ],
      "properties": {
        "Id": {
          "$ref": "#/$defs/id"
        },
        "Version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Key",
        "Label",
        "Type"
      ],
      "properties": {
        "Key": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,79}$"
        },
        "Label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "Type": {
          "enum": [
            "string",
            "boolean",
            "number",
            "secret",
            "select"
          ]
        },
        "DefaultValue": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "Required": {
          "type": "boolean",
          "default": false
        },
        "Choices": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "uniqueItems": true
        },
        "NumberConstraints": {
          "$ref": "#/$defs/numberConstraints"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "Type": {
                "const": "secret"
              }
            }
          },
          "then": {
            "properties": {
              "DefaultValue": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "Type": {
                "const": "select"
              }
            }
          },
          "then": {
            "required": [
              "Choices"
            ],
            "properties": {
              "Choices": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "numberConstraints": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "Minimum": {
          "type": [
            "number",
            "null"
          ]
        },
        "Maximum": {
          "type": [
            "number",
            "null"
          ]
        },
        "Integer": {
          "type": "boolean"
        }
      }
    },
    "sharedContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Name",
        "Version",
        "Sha256",
        "Owner"
      ],
      "properties": {
        "Name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,119}$"
        },
        "Version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "Sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "Owner": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Tables",
        "StatePrefixes"
      ],
      "properties": {
        "Tables": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "StatePrefixes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_:.-]{0,63}$"
          }
        },
        "Usage": {
          "type": "boolean"
        },
        "Audit": {
          "type": "boolean"
        },
        "Receipt": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "Contract",
            "Version"
          ],
          "properties": {
            "Contract": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "Version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ApiVersion",
        "Bindings"
      ],
      "properties": {
        "ApiVersion": {
          "const": 1
        },
        "Bindings": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "Key"
            ],
            "properties": {
              "Key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,79}$"
              },
              "LegacyFieldId": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "ReadOnly": {
                "type": "boolean"
              },
              "Trim": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ContractVersion",
        "Entry",
        "Assets"
      ],
      "properties": {
        "ContractVersion": {
          "const": 1
        },
        "Entry": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^web/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\\.html$"
        },
        "Assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "Path",
              "Sha256",
              "ContentType"
            ],
            "properties": {
              "Path": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^web/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
              },
              "Sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "ContentType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        "AllowedActions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "Kind": {
          "type": "string",
          "enum": [
            "dialog",
            "panel"
          ]
        },
        "Title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
