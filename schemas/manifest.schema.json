{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ZhaoJun233/bot-agent-plugins/main/schemas/manifest.schema.json",
  "title": "BotAgent plugin manifest API 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Id",
    "Version",
    "EntryAssembly",
    "EntryType",
    "Sha256",
    "DownloadUrl",
    "ApiVersion"
  ],
  "properties": {
    "Id": {
      "$ref": "#/$defs/id"
    },
    "Version": {
      "$ref": "#/$defs/version"
    },
    "EntryAssembly": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\\.dll$"
    },
    "EntryType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.+`]*$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "DownloadUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.zip$"
    },
    "ApiVersion": {
      "const": 1
    },
    "TargetFramework": {
      "const": "net8.0",
      "default": "net8.0"
    },
    "MinimumHostVersion": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+){0,2}$"
        }
      ]
    },
    "Permissions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{0,79}$"
      }
    },
    "Dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "Settings": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/setting"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?!preset\\.)(?!.*\\.\\.)(?!.*\\.$)[a-z][a-z0-9.-]{0,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Id",
        "Version"
      ],
      "properties": {
        "Id": {
          "$ref": "#/$defs/id"
        },
        "Version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Key",
        "Label",
        "Type"
      ],
      "properties": {
        "Key": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,79}$"
        },
        "Label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "Type": {
          "enum": [
            "string",
            "boolean",
            "number",
            "secret",
            "select"
          ]
        },
        "DefaultValue": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "Required": {
          "type": "boolean",
          "default": false
        },
        "Choices": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "Type": {
                "const": "secret"
              }
            }
          },
          "then": {
            "properties": {
              "DefaultValue": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "Type": {
                "const": "select"
              }
            }
          },
          "then": {
            "required": [
              "Choices"
            ],
            "properties": {
              "Choices": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
